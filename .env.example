# ─── NexusCore top‑level environment template ────────────────────────────────
# Copy this file to `.env` in the repo root and fill in real values.
# Do NOT commit the resulting `.env` file.

# ---------------------------------------------------------------
# Deployment mode – switch between SaaS (cloud) and on‑prem (local)
# Values: "cloud" or "local"
DEPLOYMENT_MODE=cloud

# ---------------------------------------------------------------
# Backend – vector‑store settings (only needed for local mode)
CHROMA_HOST=chromadb  # host name for local Chroma instance
CHROMA_PORT=8000

# ---------------------------------------------------------------
# Sandbox execution mode – "docker" (default) or "subprocess" for Render free‑tier
SANDBOX_MODE=docker

# ---------------------------------------------------------------
# API keys required for cloud mode (SaaS)
GEMINI_API_KEY=your-google-gemini-key
PINECONE_API_KEY=your-pinecone-key
OPENROUTER_API_KEY=your-openrouter-key
SUPABASE_DB_URL=postgresql://user:password@host:5432/postgres

# ---------------------------------------------------------------
# API keys optional for local mode (can reuse the same keys as cloud)
# GEMINI_API_KEY=your-google-gemini-key
# OPENROUTER_API_KEY=your-openrouter-key

# ---------------------------------------------------------------
# Telemetry loop – enable for local debugging (default disabled in SaaS)
ENABLE_TELEMETRY_LOOP=false

# ---------------------------------------------------------------
# Mock / demo mode – skips external LLM / vector DB calls (useful for CI)
USE_MOCK_LLM=false
