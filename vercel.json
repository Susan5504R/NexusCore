{
  "builds": [
    {
      "src": "frontend/next.config.js",
      "use": "@vercel/next"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://nexuscore-api.onrender.com/api/v1/$1"
    }
  ],
  "env": {
    "NEXT_PUBLIC_API_BASE_URL": "https://nexuscore-api.onrender.com"
  }
}
