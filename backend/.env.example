# ─── Nexus-Core environment template ──────────────────────────────────────
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# Required: Core AI and Vector DB
GEMINI_API_KEY=your-google-ai-studio-key
PINECONE_API_KEY=your-pinecone-key

# Optional: Pinecone overrides (defaults to 'nexus-core' / 'us-east-1')
# PINECONE_INDEX=nexus-core
# PINECONE_REGION=us-east-1

# Required: Operational Ledger Database (Supabase / Postgres)
SUPABASE_DB_URL=postgresql://user:password@host:5432/postgres

# Optional: proactive anomaly telemetry loop. OFF by default. When true, a
# background loop samples metrics and can autonomously fire real graph runs
# (LLM + Docker). Enable deliberately.
# ENABLE_TELEMETRY_LOOP=false
