# ─── Nexus-Core environment template ──────────────────────────────────────
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# Required from Phase 1 onward
GEMINI_API_KEY=your-google-ai-studio-key
PINECONE_API_KEY=your-pinecone-key

# Pinecone index is auto-created on startup if it does not exist.
# Override the defaults only if you want a different name/region.
# PINECONE_INDEX=nexus-core
# PINECONE_REGION=us-east-1

# Required from Phase 0.4 (operational logs ledger)
# SUPABASE_DB_URL=postgresql://user:password@host:5432/postgres

# Required from Phase 3.4 (dual-model security arbitration)
# GROQ_API_KEY=your-groq-key
